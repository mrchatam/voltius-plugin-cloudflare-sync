{
  "name": "voltius-plugin-cloudflare-sync",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "esbuild src/index.tsx --bundle --platform=browser --format=esm --external:react --external:react/jsx-runtime --external:react-dom --external:@iconify/react --external:@voltius/ui --external:@voltius/api --outfile=dist/index.js",
    "typecheck": "tsc --noEmit",
    "check": "node scripts/check-externals.mjs"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "@voltius/plugin-types": "^0.34.0",
    "esbuild": "^0.25.0",
    "typescript": "^5.6.0"
  },
  "description": "Voltius marketplace plugin: BYO Cloudflare Workers + R2 encrypted vault sync",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/mrchatam/voltius-plugin-cloudflare-sync.git"
  }
}
